# OpenAI-compatible chat completions endpoint.
# Works with OpenAI, DeepSeek, Qwen/DashScope compat mode, Moonshot, OpenRouter,
# vLLM, llama.cpp server and Ollama (/v1).
REASONING_LAB_API_BASE_URL=https://api.deepseek.com/v1
REASONING_LAB_API_KEY=sk-replace-me
REASONING_LAB_MODEL=deepseek-chat

# Request behaviour
REASONING_LAB_TIMEOUT_SECONDS=120
REASONING_LAB_MAX_CONCURRENCY=4
REASONING_LAB_MAX_RETRIES=3

# Disk cache for completions; set to an empty value to disable.
REASONING_LAB_CACHE_DIR=cache/llm

# Where run artifacts (traces, scorecards, reports) are written.
REASONING_LAB_RUN_DIR=runs

# Offline demo backend: set the provider to mock (or the base URL to mock://).
# The latency is a per-request sleep, so a nonzero value keeps a search running
# long enough to pause it and edit a step from the visualisation.
REASONING_LAB_PROVIDER=
REASONING_LAB_MOCK_LATENCY_MS=0
